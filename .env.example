# Copiar este archivo a .env y completar los valores reales.
# NUNCA subir el archivo .env real a git.

SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Postgres (Neon) — si se deja vacío, se usa SQLite local automáticamente.
DATABASE_URL=

# Storage de imágenes (Cloudflare R2) — opcional en desarrollo, usa disco local si está vacío.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_PUBLIC_DOMAIN=

# IA
GROQ_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=
REPLICATE_API_TOKEN=
