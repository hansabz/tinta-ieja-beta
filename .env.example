# Copiar este archivo a .env y completar los valores reales.
# NUNCA subir el archivo .env real a git.

SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Postgres (Neon) — si se deja vacío, se usa SQLite local automáticamente.
DATABASE_URL=

# Storage de imágenes — cualquier proveedor compatible con S3 (Backblaze B2,
# Cloudflare R2, etc.). Opcional en desarrollo, usa disco local si está vacío.
# Ej. Backblaze B2: STORAGE_ENDPOINT_URL=https://s3.us-east-005.backblazeb2.com
#     STORAGE_REGION_NAME=us-east-005
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET_NAME=
STORAGE_ENDPOINT_URL=
STORAGE_REGION_NAME=
STORAGE_PUBLIC_DOMAIN=

# IA
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
TAVILY_API_KEY=
REPLICATE_API_TOKEN=

# Email — para "Olvidé mi contraseña" (apps.users). Vacío en desarrollo: los
# emails se imprimen en la consola en vez de mandarse de verdad. En producción
# hace falta cargar esto (ej. Gmail con una "contraseña de aplicación", no tu
# contraseña normal — ver docs/).
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
